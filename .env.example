PORT=3000
# Public URL of the site, used to build payment return links
BASE_URL=http://localhost:3000
# Currency shown on the storefront (prices in server/catalog.js are in this currency)
CURRENCY=USD
# Secret used to sign payment webhooks. CHANGE THIS in production.
WEBHOOK_SECRET=change-me
# Token for the admin order list at /api/admin/orders
ADMIN_TOKEN=change-me-too
# Which adapters to use. Only "mock" ships; add real ones in server/providers/
PAYMENT_PROVIDER=mock
SUPPLIER_PROVIDER=mock
