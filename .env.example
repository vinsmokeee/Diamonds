PORT=3000
BASE_URL=http://localhost:3000

# Admin page password (/admin.html). Use a long random string.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Where orders and payment screenshots are stored
DATA_DIR=./data

# Your bank details shown on the payment page
PAY_BANK_NAME=Bank of Bhutan (mBoB)
PAY_ACCOUNT_NAME=Your Shop Name
PAY_ACCOUNT_NUMBER=
# Save your bank QR image into public/ (e.g. public/payment-qr.png) and set:
PAY_QR_IMAGE=/payment-qr.png

# Optional extra contact shown to buyers (the site has a built-in chat)
SUPPORT_CONTACT=

# Adapters: bank-qr + manual is the default for Bhutan
PAYMENT_PROVIDER=bank-qr
SUPPLIER_PROVIDER=manual

# Telegram alerts to your phone (optional, recommended). See README → Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Which alerts: payments, messages, orders (comma-separated)
TELEGRAM_ALERTS=payments,messages

# Automatic delivery via FazerCards (optional). Set SUPPLIER_PROVIDER=fazercards
# and match packages to offers in config/fazercards.json (npm run fazer:offers).
FAZER_API_KEY=
# Secret shown in FazerCards webhook settings; webhook URL = <BASE_URL>/api/webhooks/supplier
FAZER_WEBHOOK_SECRET=
